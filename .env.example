# MedIngest Environment Configuration Template
# Copy this file to '.env' and fill in your local credentials.
# Do NOT commit '.env' to version control.

# ==============================================================================
# AI & LLM PROVIDER API KEYS
# ==============================================================================
# Google Gemini API key (Required for primary extraction pipeline workflows)
GEMINI_API_KEY=

# OpenAI API key (Required for GPT-4o / GPT-4o-mini extraction fallbacks)
OPENAI_API_KEY=

# ==============================================================================
# INFRASTRUCTURE & SERVICES CONFIGURATIONS
# ==============================================================================
# PostgreSQL Connection URL
DATABASE_URL=postgresql://postgres:password123@localhost:5432/medingest

# Celery Queue Broker Connection (RabbitMQ)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Celery Result Backend Connection (Redis)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LocalStack S3 Storage URL Endpoint
S3_ENDPOINT_URL=http://localhost:4566

# Medical Data Toolkit Endpoint URL
MDT_ENDPOINT_URL=http://localhost:8080

# ==============================================================================
# PRODUCTION IAM & S3 INTEGRATIONS
# ==============================================================================
# Identity & Access Management (bezs-iam) JWKS Url endpoint
IAM_JWKS_URL=http://localhost:5001/api/auth/jwks

# AWS/S3 compatible Storage settings
AWS_S3_BUCKET_NAME=medingest-documents
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=minio_secret
AWS_REGION_NAME=us-east-1
AWS_S3_FORCE_PATH_STYLE=true
USE_PERSISTENT_STORAGE=false

