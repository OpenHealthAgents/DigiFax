# DigiFax Environment Configuration Template
# Copy this file to '.env' and fill in your local credentials.
# Do NOT commit '.env' to version control.

# ==============================================================================
# AI & LLM PROVIDER API KEYS
# ==============================================================================
# Google Gemini API key (Required for primary extraction pipeline workflows)
GEMINI_API_KEY=

# OpenAI API key (Required for GPT-4o / GPT-4o-mini extraction fallbacks)
OPENAI_API_KEY=

# ==============================================================================
# INFRASTRUCTURE & SERVICES CONFIGURATIONS
# ==============================================================================
# PostgreSQL Connection URL
DATABASE_URL=postgresql://postgres:password123@localhost:5432/digifax

# Celery Queue Broker Connection (RabbitMQ)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Celery Result Backend Connection (Redis)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LocalStack S3 Storage URL Endpoint
S3_ENDPOINT_URL=http://localhost:4566

# Medical Data Toolkit Endpoint URL
MDT_ENDPOINT_URL=http://localhost:8080
